# Binaries
/server-sim
/dummy-evaluator-bin
*.exe
*.out
# `go build ./continuous-vllm-server-evaluator` writes a binary whose name
# collides with the package directory; ignore it so it can't be committed.
/continuous-vllm-server-evaluator/continuous-vllm-server-evaluator

# Go build cache
/vendor/

# Go test artifacts
*.test
*.prof

# Environment files
.env

# Miscellaneous
/temp
.DS_Store
~*

# Saturation sweep: transient per-run output (commit selectively to docs/sweep-results/)
scripts/sweep_results/*.csv
scripts/sweep_results/*.md


# Python caches (from docs/experiment helper scripts)
__pycache__/
*.pyc
